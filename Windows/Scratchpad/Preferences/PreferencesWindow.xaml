<Window x:Class="Scratchpad.Preferences.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scratchpad Preferences"
        Width="440" Height="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <TabControl Margin="8">
        <TabItem Header="General">
            <StackPanel Margin="16">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Global Shortcut" VerticalAlignment="Center" />
                    <ContentControl x:Name="ShortcutRecorderHost" Grid.Column="1" HorizontalAlignment="Left" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Show Overlay On" VerticalAlignment="Center" />
                    <ComboBox x:Name="DisplayModeComboBox" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                              SelectionChanged="OnDisplayModeChanged">
                        <ComboBoxItem Content="All Displays" />
                        <ComboBoxItem Content="Current Display Only" />
                    </ComboBox>
                </Grid>

                <CheckBox x:Name="LaunchAtLoginCheckBox" Content="Launch at Login"
                          Checked="OnLaunchAtLoginChanged" Unchecked="OnLaunchAtLoginChanged" />
            </StackPanel>
        </TabItem>

        <TabItem Header="Appearance">
            <StackPanel Margin="16">
                <TextBlock Text="Background Dim" Margin="0,0,0,4" />
                <Slider x:Name="DimOpacitySlider" Minimum="0" Maximum="0.5" TickFrequency="0.01"
                        ValueChanged="OnDimOpacityChanged" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                    <Button Content="0%" Tag="0.0" Click="OnDimPresetClick" Margin="0,0,4,0" Padding="8,2" />
                    <Button Content="15%" Tag="0.15" Click="OnDimPresetClick" Margin="0,0,4,0" Padding="8,2" />
                    <Button Content="30%" Tag="0.30" Click="OnDimPresetClick" Margin="0,0,4,0" Padding="8,2" />
                    <Button Content="50%" Tag="0.50" Click="OnDimPresetClick" Padding="8,2" />
                </StackPanel>

                <TextBlock x:Name="AnimationDurationLabel" Text="Animation Duration" Margin="0,0,0,4" />
                <Slider x:Name="AnimationDurationSlider" Minimum="0.1" Maximum="1.0" TickFrequency="0.05"
                        ValueChanged="OnAnimationDurationChanged" Margin="0,0,0,16" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Pencil Color" VerticalAlignment="Center" />
                    <Button x:Name="PencilColorButton" Grid.Column="1" Width="60" Height="24"
                            HorizontalAlignment="Left" Click="OnPencilColorClick" />
                </Grid>

                <TextBlock x:Name="StrokeWidthLabel" Text="Pencil Thickness" Margin="0,0,0,4" />
                <Slider x:Name="StrokeWidthSlider" Minimum="1" Maximum="20" TickFrequency="0.5"
                        ValueChanged="OnStrokeWidthChanged" />
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
